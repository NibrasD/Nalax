## Pinata — لتخزين المحتوى على IPFS
VITE_PINATA_JWT=your_pinata_jwt_token_here

## InterLedger Protocol — Open Payments API
## Get these from https://rafiki.money (ILP Testnet Wallet)
## Run `npx tsx server/generate-keys.ts` to generate the key pair

# Your wallet address URL on ILP Testnet
ILP_WALLET_ADDRESS_URL=https://ilp.rafiki.money/nalax

# Auth server URL (usually provided by the testnet wallet)
ILP_AUTH_SERVER=https://auth.rafiki.money

# Ed25519 private key (base64 DER format) for signing Open Payments requests
ILP_PRIVATE_KEY_BASE64=

# Key ID assigned by the wallet when you upload your public key
ILP_KEY_ID=

# Server port for the ILP backend
ILP_SERVER_PORT=3001

# Frontend needs to know where the ILP server is
VITE_ILP_SERVER_URL=http://localhost:3001
