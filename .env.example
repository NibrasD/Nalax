## ─── Pinata — لتخزين المحتوى على IPFS ──────────────────────────
VITE_PINATA_JWT=your_pinata_jwt_token_here

## ─── Self-Hosted Rafiki Instance ────────────────────────────────
## نشر Rafiki instance خاص على Hetzner VPS
## راجع: rafiki-deploy/README.md

# عنوان VPS على Hetzner (IP أو دومين)
RAFIKI_SERVER_IP=YOUR_HETZNER_SERVER_IP

# Wallet address لـ Nalax platform داخل Rafiki instance الخاص
# يُنشأ عبر: rafiki-deploy/create-nalax-wallet.sh
ILP_WALLET_ADDRESS_URL=http://YOUR_HETZNER_SERVER_IP:3000/accounts/nalax

# Auth server لـ Rafiki instance الخاص (GNAP)
ILP_AUTH_SERVER=http://YOUR_HETZNER_SERVER_IP:3006

# Ed25519 private key (base64 DER format) لتوقيع Open Payments requests
# توليد: npx tsx server/generate-keys.ts
ILP_PRIVATE_KEY_BASE64=

# Key ID من Rafiki Admin UI بعد رفع المفتاح العام
ILP_KEY_ID=

# منفذ ILP backend server
ILP_SERVER_PORT=3001

## ─── Frontend Configuration ──────────────────────────────────────
# URL لـ ILP backend (على Render)
VITE_ILP_SERVER_URL=https://nalax-ilp-server.onrender.com

## ─── Gemini AI ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
